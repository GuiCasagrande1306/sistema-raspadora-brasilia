# Copie para .env e preencha com os dados do seu projeto Supabase.
# Enquanto SUPABASE_URL e a service role estiverem vazios, o servidor roda com dados MOCK (memória).
#
# Painel Supabase → Project Settings → API
SUPABASE_URL=https://sua-url-do-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anonima-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Bucket de Storage para documentos do DP (CNH, ASO, EPI, comprovantes)
SUPABASE_BUCKET=documentos

PORT=3400
