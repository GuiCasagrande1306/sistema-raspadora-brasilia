{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sst/cron-alertas",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/meta-leads",
      "schedule": "*/10 * * * *"
    }
  ]
}
